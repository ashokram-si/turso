# Error reporting through the PostgreSQL frontend. Expectations compare the
# SQLSTATE and not the message text: turso-pg and real PostgreSQL word their
# errors differently, and this corpus must stay valid for differential runs.

@database :memory:

test error-missing-table {
    SELECT * FROM missing;
}
@sqlstate 42P01
expect error {}

test error-missing-column {
    CREATE TABLE t (a int);
    SELECT nonexistent FROM t;
}
@sqlstate 42703
expect error {}

test error-missing-column-named-like-an-error-message {
    CREATE TABLE t (a int);
    SELECT "no such object" FROM t;
}
@sqlstate 42703
expect error {}

test error-syntax {
    SELEC 1;
}
@sqlstate 42601
expect error {}

test error-zero-parameter {
    SELECT $0;
}
@sqlstate 42P02
expect error {}

# tursopg does not have LISTEN.
@compat-gap "syntax:unsupported-statement"
test error-unsupported-statement {
    LISTEN channel;
}
expect {
}
@sqlstate 0A000
expect @tursopg error {
}

test error-values-lists-have-different-lengths {
    VALUES (1), (2, 3), (4);
}
@sqlstate 42601
expect error {}

test error-insert-values-lists-have-different-lengths {
    CREATE TABLE t (a int, b int);
    INSERT INTO t VALUES (1), (2, 3), (4);
}
@sqlstate 42601
expect error {}

test error-insert-values-default-and-short-row {
    CREATE TABLE t (a int, b int);
    INSERT INTO t (a, b) VALUES (1, DEFAULT), (2);
}
@sqlstate 42601
expect error {}

test error-aborts-rest-of-batch {
    CREATE TABLE t (a int);
    INSERT INTO t VALUES (1);
    SELECT * FROM missing;
    INSERT INTO t VALUES (2);
}
@sqlstate 42P01
expect error {}

# Schema databases are file-backed, so the schema table is dropped before each
# create to keep repeated test runs independent of old sidecar files.
test error-drop-type-used-by-table-in-other-schema {
    CREATE SCHEMA IF NOT EXISTS err_drop_type;
    DROP TABLE IF EXISTS err_drop_type.t;
    CREATE TYPE mood AS ENUM ('happy', 'sad');
    CREATE TABLE err_drop_type.t (m mood);
    DROP TYPE mood;
}
@sqlstate 2BP01
expect error {}

test error-drop-domain-used-by-table-in-other-schema {
    CREATE SCHEMA IF NOT EXISTS err_drop_domain;
    DROP TABLE IF EXISTS err_drop_domain.t;
    CREATE DOMAIN pos AS integer CHECK (VALUE > 0);
    CREATE TABLE err_drop_domain.t (v pos);
    DROP DOMAIN pos;
}
@sqlstate 2BP01
expect error {}

# Each table, view and materialized view has a row type of the same name, with
# an array type, which PostgreSQL refuses to drop while the relation is there,
# with IF EXISTS too. A catalog table's row type belongs to the system.
test error-drop-catalog-row-type-if-exists {
    DROP TYPE IF EXISTS pg_class;
}
@sqlstate 2BP01
expect error {}

test error-drop-catalog-row-type-array {
    DROP TYPE _pg_class;
}
@sqlstate 2BP01
expect error {}

test error-drop-catalog-view-row-type {
    DROP TYPE pg_tables;
}
@sqlstate 2BP01
expect error {}

test error-drop-schema-qualified-catalog-row-type {
    DROP TYPE IF EXISTS pg_catalog.pg_type;
}
@sqlstate 2BP01
expect error {}

test error-drop-domain-of-catalog-row-type {
    DROP DOMAIN IF EXISTS pg_class;
}
@sqlstate 42809
expect error {}

test error-drop-table-row-type-if-exists {
    DROP TABLE IF EXISTS err_row_t;
    CREATE TABLE err_row_t (a int);
    DROP TYPE IF EXISTS err_row_t;
}
@sqlstate 2BP01
expect error {}

test error-drop-table-row-type-array {
    DROP TABLE IF EXISTS err_row_a;
    CREATE TABLE err_row_a (a int);
    DROP TYPE err_row_a[];
}
@sqlstate 2BP01
expect error {}

test error-drop-table-row-type-array-by-catalog-name {
    DROP TABLE IF EXISTS err_row_c;
    CREATE TABLE err_row_c (a int);
    DROP TYPE _err_row_c;
}
@sqlstate 2BP01
expect error {}

test error-drop-view-row-type {
    DROP VIEW IF EXISTS err_row_v;
    CREATE VIEW err_row_v AS SELECT 1 AS x;
    DROP TYPE err_row_v;
}
@sqlstate 2BP01
expect error {}

test error-drop-domain-of-table-row-type {
    DROP TABLE IF EXISTS err_row_d;
    CREATE TABLE err_row_d (a int);
    DROP DOMAIN err_row_d;
}
@sqlstate 42809
expect error {}

# Schema databases are file-backed, so the table is dropped before each create.
test error-drop-row-type-of-table-in-other-schema {
    CREATE SCHEMA IF NOT EXISTS err_row_s;
    DROP TABLE IF EXISTS err_row_s.t;
    CREATE TABLE err_row_s.t (a int);
    DROP TYPE err_row_s.t;
}
@sqlstate 2BP01
expect error {}

test error-drop-catalog-view-row-type-array {
    DROP TYPE _pg_tables;
}
@sqlstate 2BP01
expect error {}

# pg_catalog is searched first, so pg_class names the catalog's row type even
# with a type of that name in public.
test error-drop-catalog-row-type-shadowed-by-a-user-type {
    DROP TYPE IF EXISTS public.pg_class;
    CREATE TYPE public.pg_class AS ENUM ('a');
    DROP TYPE pg_class;
}
@sqlstate 2BP01
expect error {}

test error-drop-type-used-by-a-cast-in-a-policy {
    CREATE TYPE err_policy_mood AS ENUM ('happy', 'sad');
    CREATE TABLE err_policy_t (m text);
    CREATE POLICY err_policy_p ON err_policy_t USING (m::err_policy_mood = 'happy');
    DROP TYPE err_policy_mood;
}
@sqlstate 2BP01
expect error {}

# Error reporting through the PostgreSQL frontend. Expectations compare the
# SQLSTATE and not the message text: turso-pg and real PostgreSQL word their
# errors differently, and this corpus must stay valid for differential runs.

@database :memory:

test error-missing-table {
    SELECT * FROM missing;
}
@sqlstate 42P01
expect error {}

test error-missing-column {
    CREATE TABLE t (a int);
    SELECT nonexistent FROM t;
}
@sqlstate 42703
expect error {}

test error-missing-column-named-like-an-error-message {
    CREATE TABLE t (a int);
    SELECT "no such object" FROM t;
}
@sqlstate 42703
expect error {}

test error-syntax {
    SELEC 1;
}
@sqlstate 42601
expect error {}

# tursopg does not have LISTEN.
test error-unsupported-statement {
    LISTEN channel;
}
expect {
}
@sqlstate 0A000
expect @tursopg error {}

test error-values-lists-have-different-lengths {
    VALUES (1), (2, 3), (4);
}
@sqlstate 42601
expect error {}

test error-insert-values-lists-have-different-lengths {
    CREATE TABLE t (a int, b int);
    INSERT INTO t VALUES (1), (2, 3), (4);
}
@sqlstate 42601
expect error {}

test error-insert-values-default-and-short-row {
    CREATE TABLE t (a int, b int);
    INSERT INTO t (a, b) VALUES (1, DEFAULT), (2);
}
@sqlstate 42601
expect error {}

test error-aborts-rest-of-batch {
    CREATE TABLE t (a int);
    INSERT INTO t VALUES (1);
    SELECT * FROM missing;
    INSERT INTO t VALUES (2);
}
@sqlstate 42P01
expect error {}

# Schema databases are file-backed, so the schema table is dropped before each
# create to keep repeated test runs independent of old sidecar files.
test error-drop-type-used-by-table-in-other-schema {
    CREATE SCHEMA IF NOT EXISTS err_drop_type;
    DROP TABLE IF EXISTS err_drop_type.t;
    CREATE TYPE mood AS ENUM ('happy', 'sad');
    CREATE TABLE err_drop_type.t (m mood);
    DROP TYPE mood;
}
@sqlstate 2BP01
expect error {}

test error-drop-domain-used-by-table-in-other-schema {
    CREATE SCHEMA IF NOT EXISTS err_drop_domain;
    DROP TABLE IF EXISTS err_drop_domain.t;
    CREATE DOMAIN pos AS integer CHECK (VALUE > 0);
    CREATE TABLE err_drop_domain.t (v pos);
    DROP DOMAIN pos;
}
@sqlstate 2BP01
expect error {}

test error-cast-to-unknown-type {
    SELECT 'q'::nosuch;
}
@sqlstate 42704
expect error {}

test error-cast-to-unknown-type-in-cast-syntax {
    CREATE TABLE cast_unknown (a int);
    SELECT CAST(a AS nosuch) FROM cast_unknown;
}
@sqlstate 42704
expect error {}

test error-cast-to-array-of-unknown-type {
    SELECT '{1}'::nosuch[];
}
@sqlstate 42704
expect error {
    type "nosuch\[\]" does not exist
}

test error-cast-to-underscore-name-of-a-type-alias {
    SELECT '{1}'::_integer;
}
@sqlstate 42704
expect error {
    type "_integer" does not exist
}

# information_schema is not on the search path.
test error-cast-to-unqualified-information-schema-domain {
    SELECT 'x'::sql_identifier;
}
@sqlstate 42704
expect error {
    type "sql_identifier" does not exist
}

# An index and a sequence have no row type.
test error-cast-to-name-of-an-index {
    CREATE TABLE cast_ix_t (a int);
    CREATE INDEX cast_ix ON cast_ix_t (a);
    SELECT 'x'::cast_ix;
}
@sqlstate 42704
expect error {
    type "cast_ix" does not exist
}

test error-cast-to-name-of-a-sequence {
    CREATE SEQUENCE cast_sq;
    SELECT '1'::cast_sq;
}
@sqlstate 42704
expect error {
    type "cast_sq" does not exist
}

test error-cast-to-other-name-in-information-schema {
    SELECT '1'::information_schema.int4;
}
@sqlstate 42704
expect error {
    type "information_schema.int4" does not exist
}

test error-drop-type-used-by-a-cast-in-a-policy {
    CREATE TYPE err_policy_mood AS ENUM ('happy', 'sad');
    CREATE TABLE err_policy_t (m text);
    CREATE POLICY err_policy_p ON err_policy_t USING (m::err_policy_mood = 'happy');
    DROP TYPE err_policy_mood;
}
@sqlstate 2BP01
expect error {}

# A built-in type that tursopg has no type for, a row type and a domain of
# information_schema are refused as not supported: tursopg would not give
# the value PostgreSQL gives.
@skip-if postgres "PostgreSQL casts to xid"
test error-cast-to-builtin-type-without-a-tursopg-type {
    SELECT '1'::xid;
}
@sqlstate 0A000
expect error {
    a cast to type "xid" is not supported
}

@skip-if postgres "PostgreSQL casts to point[]"
test error-cast-to-array-of-builtin-type-without-a-tursopg-type {
    SELECT '{"(1,2)"}'::_point;
}
@sqlstate 0A000
expect error {
    a cast to type "_point" is not supported
}

@skip-if postgres "PostgreSQL casts to a table's row type"
test error-cast-to-row-type-of-a-table {
    CREATE TABLE cast_row_t (a int);
    SELECT '(1)'::cast_row_t;
}
@sqlstate 0A000
expect error {
    a cast to the row type of "cast_row_t" is not supported
}

@skip-if postgres "PostgreSQL casts to its information_schema domains"
test error-cast-to-information-schema-domain {
    SELECT 'x'::information_schema.sql_identifier;
}
@sqlstate 0A000
expect error {
    a cast to type "information_schema.sql_identifier" is not supported
}
